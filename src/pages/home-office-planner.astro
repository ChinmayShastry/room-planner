---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlannerLanding from '../components/PlannerLanding.astro';
import { appSchema, faqSchema, GUIDE_SECTIONS } from '../lib/content';
import type { FaqItem, GuideSection } from '../lib/content';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const title = 'Home Office Planner – Plan Your Desk and Office Layout';
const description =
  'Free home office planner. Position your desk, chair and shelving to scale, check you have room to push the chair back, and plan around the window and power sockets.';

const guide: GuideSection[] = [
  {
    id: 'plan-a-home-office',
    title: 'How to plan a home office layout',
    body: [
      'A home office is planned around two things you cannot move: the window and the power. Get the desk right relative to those, and the rest of the room is straightforward.',
      'The most common mistake is forgetting the chair. A desk is not 2 ft deep in practice — it is 2 ft of desk plus roughly 3 ft of floor behind it so you can push the chair back and stand up.',
    ],
    points: [
      'Allow about 3 ft behind the desk for the chair to move.',
      'Facing a window gives glare on the screen; a window to one side is usually best.',
      'Put the desk where a cable can reach a socket without crossing a walkway.',
      'Leave the door swing clear — an office door often opens into the only free corner.',
    ],
  },
  {
    id: 'desk-sizes',
    title: 'What size desk do you actually need?',
    body: [
      'A single monitor and a laptop need about 4 ft of width. Two monitors need about 5 ft. Below 3 ft 4 in, a desk stops being comfortable for full days.',
      'Depth matters more than people expect: 2 ft is fine for a laptop, but a monitor wants 2 ft 6 in so it is not sitting at the end of your nose.',
    ],
    points: [
      'Compact desk: 3 ft 4 in × 1 ft 8 in — laptop only.',
      'Standard desk: 4 ft × 2 ft — laptop plus notes.',
      'Full desk: 5 ft × 2 ft 6 in — monitor, keyboard and room to write.',
      'Corner desk: about 5 ft × 5 ft — two monitors, but it claims a whole corner.',
    ],
  },
  {
    id: 'office-in-a-bedroom',
    title: 'Fitting an office into a bedroom or corner',
    body: [
      'Most home offices are not rooms; they are a corner of one. Planning that corner to scale is the difference between a desk you use and a desk you pile laundry on.',
    ],
    points: [
      'A wall-mounted desk removes the legs and leaves the floor visually clear.',
      'A desk at the foot of a bed needs the chair space, so measure from the bed frame.',
      'Shelving above the desk uses wall, not floor — the scarce resource in a shared room.',
      'Check the chair does not block the bedroom door when pushed back.',
    ],
  },
  GUIDE_SECTIONS.measuring!,
];

const faq: FaqItem[] = [
  {
    question: 'How much space do I need behind a desk for the chair?',
    answer:
      'About 3 ft (90 cm) from the desk edge to whatever is behind you. That covers pushing the chair back and standing up. If someone needs to walk behind you while you are seated, allow 4 ft.',
  },
  {
    question: 'What is a good home office size?',
    answer:
      'A 10 × 12 ft room is comfortable for a desk, chair, shelving and a filing cabinet. A dedicated office can work in as little as 7 × 8 ft if the desk goes against the long wall.',
  },
  {
    question: 'Should my desk face the window?',
    answer:
      'Usually not directly. Facing a window puts bright light behind your screen, which causes glare and eye strain. A window to one side gives you daylight without fighting the monitor.',
  },
  {
    question: 'Can I plan a standing desk?',
    answer:
      'Yes. Add an office desk and set its real width and depth. The floor plan is the same whether the desk is fixed or height-adjustable — what changes is only the space behind it, which stays the same.',
  },
  {
    question: 'Can I save the office layout and come back to it?',
    answer:
      'Yes. The planner saves your work in this browser automatically, and you can save named layouts. Export the layout file to move it to another computer.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/home-office-planner"
  schema={[
    appSchema('Home Office Planner', description, `${siteUrl}/home-office-planner`),
    faqSchema(faq),
  ]}
>
  <PlannerLanding
    heading="Home office planner"
    intro="Position your desk, chair and shelving to scale before you buy anything. Check that you can push the chair back, reach a socket, and still open the door."
    template="home-office"
    ctaLabel="Plan my office"
    checklist={[
      'Measure the room and note the window position.',
      'Find the nearest power socket — cables decide desk placement more than taste does.',
      'Allow about 3 ft of clear floor behind the desk for the chair.',
      'Check the door swing before committing to a corner.',
    ]}
    sizeTable={{
      caption: 'Typical home office furniture sizes',
      rows: [
        { label: 'Compact desk', imperial: '3 ft 4 in × 1 ft 8 in', metric: '102 × 51 cm' },
        { label: 'Standard desk', imperial: '4 ft × 2 ft', metric: '122 × 61 cm' },
        { label: 'Full desk', imperial: '5 ft × 2 ft 6 in', metric: '152 × 76 cm' },
        { label: 'Office chair', imperial: '2 ft 2 in × 2 ft 2 in', metric: '66 × 66 cm' },
        { label: 'Chair clearance behind desk', imperial: '3 ft', metric: '90 cm' },
        { label: 'Filing cabinet', imperial: '1 ft 6 in × 2 ft', metric: '46 × 61 cm' },
        { label: 'Bookshelf', imperial: '3 ft × 1 ft', metric: '91 × 30 cm' },
      ],
    }}
    guide={guide}
    faq={faq}
  />
</BaseLayout>
