---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlannerApp from '../components/planner/PlannerApp.astro';
import { appSchema } from '../lib/content';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const title = 'Room Planner – Draw Your Room and Arrange Furniture';
const description =
  'Draw your room to scale, add furniture, doors and windows, then drag everything into place. Free online room planner with measurements, warnings and image export.';
---

<BaseLayout
  title={title}
  description={description}
  canonical="/room-planner"
  variant="app"
  schema={[appSchema('Room Planner', description, `${siteUrl}/room-planner`)]}
>
  <PlannerApp openSetup={true} room={{ name: 'Bedroom', width: 12, length: 14, unit: 'ft' }} />
</BaseLayout>
