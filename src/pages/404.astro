---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/room-planner', label: 'Room Planner', body: 'Draw a room and arrange furniture.' },
  { href: '/bedroom-planner', label: 'Bedroom Planner', body: 'Beds, wardrobes and walkways.' },
  { href: '/living-room-planner', label: 'Living Room Planner', body: 'Sofas, tables and the TV wall.' },
  { href: '/furniture-fit-calculator', label: 'Will It Fit?', body: 'Check an item against your room and door.' },
];
---

<BaseLayout
  title="Page not found – Room Planner"
  description="That page does not exist. Head back to the room planner or pick one of the planning tools."
  noindex={true}
>
  <section class="rp-container py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-ink">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      That page is not here
    </h1>
    <p class="mt-3 max-w-xl text-lg leading-relaxed text-ink-soft">
      The link may be out of date, or the address may have a typo in it. Your saved layouts are unaffected
      — they live in your browser, not on this page.
    </p>

    <a href="/room-planner" class="rp-btn rp-btn-primary rp-btn-lg mt-6">
      Open the room planner
      <Icon name="arrow-right" size={18} />
    </a>

    <div class="mt-10 grid gap-2.5 sm:grid-cols-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent hover:bg-accent-soft"
          >
            <p class="font-medium text-ink">{link.label}</p>
            <p class="mt-0.5 text-sm text-ink-soft">{link.body}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
