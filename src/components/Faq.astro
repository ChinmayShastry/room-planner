---
import type { FaqItem } from '../lib/content';

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}

const { items, title = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section id={id} class="rp-container py-12">
  <h2 class="text-2xl font-semibold tracking-tight text-ink">{title}</h2>
  <div class="mt-5 max-w-3xl divide-y divide-line rounded-lg border border-line bg-surface">
    {
      items.map((item, index) => (
        <details class="group" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3.5 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              class="shrink-0 text-ink-faint transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="px-4 pb-4 text-[15px] leading-relaxed text-ink-soft">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
