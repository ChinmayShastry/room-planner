---
import { ROOM_PRESETS } from '../../lib/planner/state';
import { UNIT_NAME } from '../../lib/planner/units';
import { UNITS } from '../../lib/planner/types';
import Icon from '../Icon.astro';

interface Props {
  /** Open on load — used by /room-planner when there is nothing to restore. */
  defaultName?: string;
  defaultWidth?: number;
  defaultLength?: number;
}

const { defaultName = 'Bedroom', defaultWidth = 12, defaultLength = 14 } = Astro.props;
---

<dialog
  class="rp-setup rp-no-print"
  data-rp="setup"
  aria-labelledby="setup-title"
>
  <form method="dialog" data-rp="setup-form" novalidate>
    <div class="flex items-start justify-between gap-3 border-b border-line px-5 py-4">
      <div>
        <h2 id="setup-title" class="text-lg font-semibold text-ink">Create your room</h2>
        <p class="mt-0.5 text-sm text-ink-soft">Measure wall to wall. You can change this later.</p>
      </div>
      <button
        type="button"
        class="rp-icon-btn -mr-1 shrink-0"
        data-action="close-setup"
        aria-label="Close"
        formnovalidate
      >
        <Icon name="close" size={18} />
      </button>
    </div>

    <div class="px-5 py-4">
      <div class="mb-3">
        <label class="rp-field" for="setup-name">Room name</label>
        <input
          id="setup-name"
          name="name"
          type="text"
          class="rp-input"
          value={defaultName}
          maxlength="60"
          autocomplete="off"
        />
      </div>

      <div class="grid grid-cols-3 gap-2">
        <div>
          <label class="rp-field" for="setup-width">Width</label>
          <input
            id="setup-width"
            name="width"
            type="number"
            class="rp-input"
            value={defaultWidth}
            min="1"
            step="0.25"
            inputmode="decimal"
            required
            aria-describedby="setup-width-error"
          />
        </div>
        <div>
          <label class="rp-field" for="setup-length">Length</label>
          <input
            id="setup-length"
            name="length"
            type="number"
            class="rp-input"
            value={defaultLength}
            min="1"
            step="0.25"
            inputmode="decimal"
            required
            aria-describedby="setup-length-error"
          />
        </div>
        <div>
          <label class="rp-field" for="setup-unit">Unit</label>
          <select id="setup-unit" name="unit" class="rp-select">
            {UNITS.map((unit) => <option value={unit}>{UNIT_NAME[unit]}</option>)}
          </select>
        </div>
      </div>

      <p class="rp-error" id="setup-width-error" data-error="width" hidden></p>
      <p class="rp-error" id="setup-length-error" data-error="length" hidden></p>

      <fieldset class="mt-4">
        <legend class="rp-field">Or start from a common size</legend>
        <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
          {
            ROOM_PRESETS.map((preset) => (
              <button
                type="button"
                class="rp-template-card"
                data-preset={preset.id}
                data-preset-width={preset.widthFt}
                data-preset-length={preset.lengthFt}
                data-preset-name={preset.name}
              >
                <span class="block text-[13px] font-medium text-ink">{preset.name}</span>
                <span class="block text-xs text-ink-faint">{preset.description}</span>
              </button>
            ))
          }
        </div>
      </fieldset>
    </div>

    <div class="flex items-center justify-end gap-2 border-t border-line bg-surface-sunk px-5 py-3">
      <button type="button" class="rp-btn rp-btn-ghost" data-action="close-setup" formnovalidate>Cancel</button>
      <button type="submit" class="rp-btn rp-btn-primary">
        Create room
        <Icon name="arrow-right" size={16} />
      </button>
    </div>
  </form>
</dialog>

<style is:global>
  .rp-setup {
    /* Tailwind's preflight zeroes margins, which removes the UA rule that
       centres a modal dialog — put it back explicitly. */
    margin: auto;
    width: min(34rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 3rem);
    overflow: auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-pop);
  }

  .rp-setup::backdrop {
    background-color: rgb(42 39 36 / 0.42);
    backdrop-filter: blur(2px);
  }

  /* Dialogs are display:none until opened; keep that behaviour explicit. */
  .rp-setup:not([open]) {
    display: none;
  }
</style>
